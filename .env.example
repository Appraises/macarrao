# Local development default. Production builds must use https://api.dicionariogamer.com
# and VITE_SITE_URL=https://dicionariogamer.com.
VITE_API_URL=http://localhost:3001
VITE_SITE_URL=https://seu-dominio.com
# O build de producao falha se a API nao devolver termos e noticias, para nunca
# publicar um site/sitemap parcial. Use true apenas em build local sem backend.
SSG_ALLOW_EMPTY=false

# Analytics próprio: a coleta usa a API first-party configurada em VITE_API_URL.
# Site key publica do widget Cloudflare Turnstile. A secret key fica apenas no backend.
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Confirm these before publishing the legal pages.
VITE_LEGAL_CONTROLLER_NAME=Dicionário Gamer
VITE_LEGAL_CONTACT_EMAIL=privacidade@seu-dominio.com.br
