[Unit]
Description=Publicacao de noticias do Dicionario Gamer nas redes sociais
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=blopes
Group=blopes
WorkingDirectory=/srv/dicionario/server
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run social:publish
TimeoutStartSec=4min
NoNewPrivileges=true
