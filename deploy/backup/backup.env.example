# Copie para /etc/dicionario/backup.env (root:root, 0600) e ajuste.

# Pasta local dos dumps e dos pacotes de uploads.
BACKUP_DIR=/var/backups/dicionario
# Dias de retencao local.
RETENTION_DAYS=14

# Pasta de uploads da API. Se UPLOAD_DIR estiver definido no .env da API, use o mesmo valor.
UPLOAD_DIR=/srv/dicionario/server/uploads

# .env da API, de onde o DATABASE_URL e lido.
APP_ENV_FILE=/srv/dicionario/server/.env

# Copia externa (fortemente recomendada). Configure o remote com `sudo rclone config`
# apontando para um bucket R2/S3/B2 dedicado, com credencial que so escreve nesse bucket.
# Exemplo: RCLONE_REMOTE=r2:dicionario-backups
RCLONE_REMOTE=
REMOTE_RETENTION_DAYS=35
