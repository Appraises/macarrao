// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER") // ADMIN, USER
  level     Int      @default(1)
  xp        Int      @default(0)
  badges    Json     @default("[]")
  avatar    String?
  emailVerified Boolean @default(false)
  verificationToken String?
  preferences Json   @default("{}")
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments  Comment[]
  terms     Term[]
  contributions Contribution[]
  favoriteGameId String?
  favoriteGame Game? @relation(fields: [favoriteGameId], references: [id])
}

model Game {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  genre     String
  image     String
  terms     Term[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  maps      GameMap[]
  favoritedBy User[]
}

model GameMap {
  id            String       @id @default(uuid())
  gameId        String
  game          Game         @relation(fields: [gameId], references: [id])
  name          String
  image         String
  tacticalImage String?
  callouts      MapCallout[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([gameId])
}

model MapCallout {
  id          String   @id @default(uuid())
  mapId       String
  map         GameMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name        String
  description String?
  x           Float
  y           Float
  type        String   // Site, Spawn, Callout, Objective, Item
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mapId])
}

model Term {
  id                 String   @id @default(uuid())
  word               String
  definition         String
  phonetic           String?
  pronunciationGuide String?
  examples           Json     @default("[]")
  relatedTerms       Json?
  gameId             String?
  game               Game?    @relation(fields: [gameId], references: [id])
  upvotes            Int      @default(0)
  downvotes          Int      @default(0)
  tags               Json     @default("[]")
  verified           Boolean  @default(false)
  views              TermView[]
  authorId           String?
  author             User?    @relation(fields: [authorId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([word])
  @@index([gameId])
  @@index([verified])
  @@index([authorId])
  @@index([createdAt])
}

model TermView {
  id        String   @id @default(uuid())
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([termId, createdAt])
}

model News {
  id        String   @id @default(uuid())
  headline  String
  category  String
  image     String?
  content   String?
  author    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}


model Contribution {
  id         String   @id @default(uuid())
  word       String
  definition String
  gameId     String?
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([authorId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  newsId    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([newsId])
  @@index([userId])
}

// ==================== ESPORTS MODELS ====================

model Tournament {
  id          String   @id @default(uuid())
  name        String
  game        String
  logo        String?
  status      String   @default("Upcoming") // Live, Playoffs, Group Stage, Upcoming, Finished
  dates       String?
  prizePool   String?
  image       String?
  description String?
  organizer   String?
  location    String?
  format      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams      TournamentTeam[]
  standings  TournamentStanding[]
  bracket    BracketMatch[]
  stats      PlayerStat[]

  @@index([game])
  @@index([status])
}

model TournamentTeam {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  country      String     @default("xx")

  @@index([tournamentId])
}

model TournamentStanding {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  rank         Int
  teamName     String
  teamCountry  String     @default("xx")
  teamLogo     String?
  played       Int        @default(0)
  wins         Int        @default(0)
  losses       Int        @default(0)
  points       Int        @default(0)
  diff         Int        @default(0)
  streak       String?

  @@index([tournamentId])
}

model BracketMatch {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchKey     String     // e.g. qf1, sf1, gf
  round        String     // Quarterfinals, Semifinals, Grand Final
  teamAName    String
  teamAScore   Int?
  teamAWinner  Boolean    @default(false)
  teamBName    String
  teamBScore   Int?
  teamBWinner  Boolean    @default(false)
  date         String?
  status       String     @default("Scheduled") // Scheduled, Live, Finished

  @@index([tournamentId])
}

model EsportsMatch {
  id           String   @id @default(uuid())
  game         String
  competition  String
  teamAName    String
  teamACountry String   @default("xx")
  teamALogo    String?
  teamBName    String
  teamBCountry String   @default("xx")
  teamBLogo    String?
  time         String?
  date         String?
  isLive       Boolean  @default(false)
  scoreA       Int?
  scoreB       Int?
  oddsA        Float?
  oddsB        Float?
  createdAt    DateTime @default(now())

  @@index([game])
  @@index([isLive])
}

model EsportsNews {
  id        String   @id @default(uuid())
  headline  String
  category  String
  timeAgo   String?
  image     String?
  author    String?
  createdAt DateTime @default(now())

  @@index([category])
}

model TeamRanking {
  id          String @id @default(uuid())
  rank        Int
  teamName    String
  teamCountry String @default("xx")
  points      Int    @default(0)
  trend       String @default("stable") // up, down, stable
  game        String

  @@index([game])
}

model PickemUser {
  id         String @id @default(uuid())
  rank       Int
  username   String
  points     Int    @default(0)
  percentile String @default("0%")
}

model PlayerStat {
  id           String      @id @default(uuid())
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  team         String
  country      String      @default("xx")
  role         String?
  photo        String?
  stats        Json        @default("{}")

  @@index([tournamentId])
}
