DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dicionariogamer"
PORT=3001
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
CORS_ORIGINS="http://localhost:3000,http://localhost:4173,http://localhost:4175"
PUBLIC_API_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Cloudflare Turnstile e limites de contribuicao.
#
# Crie um widget no painel Turnstile e use chaves separadas por ambiente.
# A site key publica fica no .env do frontend como VITE_TURNSTILE_SITE_KEY.
# A secret key abaixo nunca deve chegar ao bundle ou ao navegador.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_TIMEOUT_MS=3000
ABUSE_HASH_SECRET="troque-por-outro-segredo-longo-e-aleatorio"

# Uma conta pode enviar no maximo 5 contribuicoes a cada 30 minutos.
CONTRIBUTION_ACCOUNT_LIMIT=5
CONTRIBUTION_ACCOUNT_WINDOW_MINUTES=30
# Limite adicional agregado por rede/IP, armazenado apenas como HMAC.
CONTRIBUTION_IP_LIMIT=20
CONTRIBUTION_IP_WINDOW_MINUTES=30

# O desafio adaptativo reaparece quando a confianca expira ou a atividade acelera.
BOT_TRUST_MINUTES=30
BOT_NEW_ACCOUNT_HOURS=24
CONTRIBUTION_CHALLENGE_THRESHOLD=2
CONTRIBUTION_DAILY_CHALLENGE_THRESHOLD=5
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# E-mail transacional (Resend) -- recuperacao de senha, verificacao de conta,
# avisos de LGPD e decisoes de moderacao.
#
# Sem RESEND_API_KEY o servidor sobe normalmente, mas NENHUM e-mail e enviado:
# o usuario pede "esqueci minha senha", ve a mensagem de sucesso e nada chega.
# O boot avisa no console quando isto acontece.
#
# Passo a passo:
#   1. Crie a conta em https://resend.com e gere a API key (comeca com "re_").
#   2. Em Domains > Add Domain, cadastre seu dominio (ex.: dicionariogamer.com.br).
#   3. Publique no DNS os registros que o Resend mostrar -- SPF (TXT), DKIM (CNAME)
#      e, se oferecido, o de retorno/Return-Path. A propagacao leva de minutos a horas.
#   4. Espere o dominio ficar "Verified" no painel.
#   5. Ajuste EMAIL_FROM para um endereco DESSE dominio verificado.
# Enquanto o dominio nao estiver verificado o Resend recusa o envio.
#
# APP_URL e a base de todos os links dos e-mails (ex.: o link de redefinir senha).
# Em producao precisa ser o dominio publico real, senao os links vao para localhost.
APP_URL="http://localhost:4175"
RESEND_API_KEY=
EMAIL_FROM="Dicionario Gamer <contato@seu-dominio.com.br>"

# Newsletter Termo do Dia. Mantenha desativada durante a primeira implantacao.
# O segredo do webhook aparece no painel do Resend ao criar o endpoint:
# https://api.seu-dominio.com.br/webhooks/resend
RESEND_WEBHOOK_SECRET=
NEWSLETTER_TOKEN_SECRET="troque-por-um-segredo-exclusivo-longo-e-aleatorio"
NEWSLETTER_ENABLED=false
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Pre-filtro de imagens (SafeSearch) para as imagens enviadas pela comunidade.
#
# Desligado por padrao: a imagem enviada fica PENDENTE e invisivel ate o dono do
# termo aceitar -- essa e a protecao principal, nao a deteccao automatica.
#
# Quando ligado, cada upload e checado ANTES de chegar ao dono. Imagem reprovada
# (ou erro na checagem) e marcada como "sinalizada" e vai para a fila do ADMIN,
# nunca para o dono do termo. O upload nunca e bloqueado, so redirecionado.
#
# Provider suportado: google (Cloud Vision SafeSearch). Requer faturamento ativo
# no Google Cloud e a Vision API habilitada; a chave e uma API key restrita a ela.
# Detectar conteudo ilegal com garantia exige servicos especializados (PhotoDNA
# /NCMEC) -- isto aqui cobre nudez/violencia, com margem de erro.
IMAGE_MODERATION_ENABLED=false
IMAGE_MODERATION_PROVIDER=google
IMAGE_MODERATION_API_KEY=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Armazenamento das imagens enviadas (capas de jogo, mapas, imagens de termo).
#
# local (padrao) — arquivos no disco do proprio servidor. Funciona num VPS com
#   disco persistente. NAO use em host efemero (Vercel, Render, Railway): cada
#   deploy apaga tudo. Tambem nao funciona com mais de uma instancia, porque a
#   imagem so existe na maquina que recebeu o upload.
#
# s3 — qualquer bucket compativel com S3: AWS S3, Cloudflare R2, Backblaze B2,
#   MinIO. Sobrevive a deploys e e compartilhado entre instancias.
#
# Cloudflare R2 (recomendado — sem custo de egresso):
#   MEDIA_DRIVER=s3
#   MEDIA_S3_BUCKET=dicionariogamer
#   MEDIA_S3_REGION=auto
#   MEDIA_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#   MEDIA_S3_PUBLIC_URL=https://cdn.seu-dominio.com.br   (dominio publico do bucket)
# Para AWS S3, deixe MEDIA_S3_ENDPOINT vazio e use a regiao real (ex.: sa-east-1).
MEDIA_DRIVER=local
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PUBLIC_URL=
# ---------------------------------------------------------------------------

