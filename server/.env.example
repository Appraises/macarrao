ESPORTS_FOCUS_KEYWORDS="brasil,brazil,cblol,lta south,cbcs,challengers brazil,vct brazil,game changers brazil,liga gg,fireleague brazil"
ESPORTS_FOCUS_TEAMS="LOUD,paiN Gaming,FURIA,MIBR,Fluxo,RED Canids,Vivo Keyd,KaBuM,INTZ,Los Grandes,Liberty,2GAME,Corinthians Esports,w7m esports,Team Liquid Brazil"

